---
import Logo from './Logo.astro';
import { NAV } from '../data/site';

const path = Astro.url.pathname;
const isCurrent = (href: string) => href !== '/' && !href.startsWith('/#') && path.startsWith(href);
---

<header class="wk-header">
  <div class="wk-container wk-header__inner">
    <a href="/" class="wk-header__home" aria-label="WebARKit home"><Logo /></a>

    <button
      class="wk-header__menu"
      type="button"
      aria-expanded="false"
      aria-controls="wk-nav"
      aria-label="Open menu"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"
        ></path>
      </svg>
    </button>

    <nav id="wk-nav" class="wk-header__nav" aria-label="Main">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="wk-header__tools">
        <a class="wk-icon-btn" href="https://github.com/webarkit" aria-label="WebARKit on GitHub">
          <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="M9 19c-4 1.5-4-2-6-2.5M15 21v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12 12 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
        <button class="wk-icon-btn wk-theme-toggle" type="button" aria-label="Switch to light theme">
          <svg class="wk-sun" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"></circle>
            <path
              d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"></path>
          </svg>
          <svg class="wk-moon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linejoin="round"></path>
          </svg>
        </button>
      </div>
    </nav>
  </div>
</header>

<script>
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>('.wk-theme-toggle');
  const label = () =>
    toggle?.setAttribute(
      'aria-label',
      root.dataset.theme === 'light' ? 'Switch to dark theme' : 'Switch to light theme',
    );
  label();
  toggle?.addEventListener('click', () => {
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    root.dataset.theme = next;
    try {
      // Same key as the Starlight docs, so the choice carries over.
      localStorage.setItem('starlight-theme', next);
    } catch {}
    label();
  });

  const menu = document.querySelector<HTMLButtonElement>('.wk-header__menu');
  const nav = document.getElementById('wk-nav');
  menu?.addEventListener('click', () => {
    const open = menu.getAttribute('aria-expanded') !== 'true';
    menu.setAttribute('aria-expanded', String(open));
    menu.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    nav?.classList.toggle('is-open', open);
  });
</script>

<style>
  .wk-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--wk-header-bg);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--wk-line);
  }
  .wk-header__inner {
    display: flex;
    align-items: center;
    gap: 16px 32px;
    min-height: 64px;
    flex-wrap: wrap;
  }
  .wk-header__home {
    display: flex;
    color: var(--wk-text);
  }
  .wk-header__nav {
    display: flex;
    align-items: center;
    gap: 16px 24px;
    flex: 1 1 auto;
  }
  .wk-header__nav ul {
    display: flex;
    gap: 4px 24px;
    list-style: none;
    margin: 0;
    padding: 0;
    flex: 1 1 auto;
  }
  .wk-header__nav ul a {
    color: var(--wk-text-2);
    font-size: 15px;
    padding: 10px 0;
    display: inline-block;
  }
  .wk-header__nav ul a:hover,
  .wk-header__nav ul a[aria-current='page'] {
    color: var(--wk-text);
  }
  .wk-header__nav ul a[aria-current='page'] {
    box-shadow: inset 0 -2px 0 var(--wk-accent);
  }
  .wk-header__tools {
    display: flex;
    gap: 8px;
  }
  .wk-icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 40px;
    border: 1px solid var(--wk-line-strong);
    border-radius: var(--wk-radius-sm);
    background: transparent;
    color: var(--wk-text);
    cursor: pointer;
  }
  .wk-icon-btn:hover {
    color: var(--wk-text);
    border-color: var(--wk-link);
  }
  .wk-moon {
    display: none;
  }
  :global([data-theme='light']) .wk-sun {
    display: none;
  }
  :global([data-theme='light']) .wk-moon {
    display: block;
  }
  .wk-header__menu {
    display: none;
    margin-left: auto;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid var(--wk-line-strong);
    border-radius: var(--wk-radius-sm);
    color: var(--wk-text);
    cursor: pointer;
  }

  @media (max-width: 820px) {
    .wk-header__menu {
      display: inline-flex;
    }
    .wk-header__nav {
      display: none;
      flex-basis: 100%;
      flex-direction: column;
      align-items: stretch;
      padding-bottom: 16px;
    }
    .wk-header__nav.is-open {
      display: flex;
    }
    .wk-header__nav ul {
      flex-direction: column;
    }
    .wk-header__nav ul a {
      display: block;
      padding: 12px 0;
      border-bottom: 1px solid var(--wk-line);
    }
    .wk-header__nav ul a[aria-current='page'] {
      box-shadow: none;
      color: var(--wk-accent);
    }
  }
</style>
