---
/** Teaser for WebARKit Studio, drawn as a small node graph. */
const nodes = [
  { id: 'cam', title: 'Camera', body: 'facing: environment', kind: 'source', x: 4, y: 14 },
  { id: 'target', title: 'Image target', body: 'pinball.wnft', kind: 'data', x: 4, y: 58 },
  { id: 'tracker', title: 'NFT Tracker', body: '→ pose · found / lost', kind: 'source', x: 41, y: 33 },
  { id: 'model', title: 'GLTF model', body: 'duck.glb', kind: 'asset', x: 30, y: 74 },
  { id: 'scene', title: 'Scene', body: 'Three.js', kind: 'out', x: 77, y: 18 },
  { id: 'export', title: 'Export', body: 'static app', kind: 'out', x: 77, y: 62 },
];
---

<section id="studio" class="wk-section wk-section--alt">
  <div class="wk-container wk-studio">
    <div class="wk-studio__text">
      <p class="wk-eyebrow">02 / Studio</p>
      <h2 class="wk-h2">Compose AR like a node graph</h2>
      <p>
        WebARKit Studio is a visual editor: wire a camera, a marker and a 3D model together, preview it
        live, and export a ready-to-host WebAR app.
      </p>
      <p class="wk-studio__status">In development</p>
      <a class="wk-btn" href="https://github.com/webarkit/webarkit-studio">Follow on GitHub</a>
    </div>

    <div class="wk-studio__graph" role="img" aria-label="Example Studio graph: Camera and Image target feed an NFT Tracker, which drives a Three.js scene with a GLTF model, then exports a static app">
      <svg viewBox="0 0 720 380" preserveAspectRatio="none" aria-hidden="true">
        <path d="M196 92 C 260 92, 250 168, 300 168" class="w-a"></path>
        <path d="M196 262 C 260 262, 250 196, 300 196" class="w-b"></path>
        <path d="M480 182 C 520 182, 520 104, 556 104" class="w-c"></path>
        <path d="M480 182 C 520 182, 520 270, 556 270" class="w-c"></path>
        <path d="M376 300 C 440 300, 500 120, 556 116" class="w-d"></path>
      </svg>
      {
        nodes.map((n) => (
          <div class={`wk-gnode wk-gnode--${n.kind}`} style={`left:${n.x}%;top:${n.y}%`} aria-hidden="true">
            <div class="wk-gnode__head">{n.title}</div>
            <div class="wk-gnode__body">{n.body}</div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .wk-studio {
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
    align-items: center;
    padding-top: 80px;
    padding-bottom: 80px;
  }
  .wk-studio__text {
    flex: 1 1 340px;
    min-width: 0;
  }
  .wk-studio__text > p:not(.wk-eyebrow) {
    color: var(--wk-text-2);
    margin: 16px 0 24px;
  }
  .wk-studio__text .wk-studio__status {
    display: inline-block;
    font-family: var(--wk-font-mono);
    font-size: 12px;
    color: var(--wk-accent);
    border: 1px solid var(--wk-accent-soft);
    border-radius: 999px;
    padding: 4px 12px;
    margin: 0 0 24px;
  }
  .wk-studio__graph {
    flex: 2 1 540px;
    min-width: 0;
    position: relative;
    height: 380px;
    border: 1px solid var(--wk-line-strong);
    border-radius: 16px;
    background-color: var(--wk-bg);
    background-image: radial-gradient(var(--wk-line-strong) 1px, transparent 1px);
    background-size: 22px 22px;
    overflow: hidden;
  }
  .wk-studio__graph svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .wk-studio__graph path {
    fill: none;
    stroke-width: 2.5;
    vector-effect: non-scaling-stroke;
  }
  .w-a {
    stroke: var(--wk-link);
  }
  .w-b {
    stroke: var(--wk-accent);
  }
  .w-c {
    stroke: var(--wk-green);
  }
  .w-d {
    stroke: #c98af0;
  }
  .wk-gnode {
    position: absolute;
    width: 22%;
    min-width: 110px;
    background: var(--wk-surface-2);
    border: 1px solid var(--wk-line-node);
    border-radius: 10px;
    font-size: 13px;
    overflow: hidden;
  }
  .wk-gnode__head {
    padding: 6px 10px;
    font-weight: 600;
    color: #fff;
    background: var(--wk-brand);
  }
  .wk-gnode--data .wk-gnode__head {
    background: #5e2140;
  }
  .wk-gnode--asset .wk-gnode__head {
    background: #4a2a63;
  }
  .wk-gnode--out .wk-gnode__head {
    background: #1d4a36;
  }
  .wk-gnode__body {
    padding: 8px 10px;
    color: var(--wk-text-3);
  }
  @media (max-width: 600px) {
    .wk-studio__graph {
      height: 300px;
    }
    .wk-gnode {
      font-size: 11px;
    }
  }
</style>
