---
import ToolLayout from '../../../layouts/ToolLayout.astro';
// The tool itself: public/tools/FeatureSet-Display/ (index.js, dist/ARFset.js).
---

<ToolLayout
  title="FeatureSet Display"
  description="Load the three files of an NFT marker (.iset, .fset, .fset3) and see its feature points, to judge how well it will track before you print it."
  docs="/docs/tools/featureset-display/"
>
  <div class="wk-tool__panel">
    <div class="wk-tool__actions">
      <input type="file" id="markerLoader" name="markerLoader" class="sr-only" multiple accept=".iset,.fset,.fset3" />
      <button class="wk-btn wk-btn--primary" id="uploadBt" type="button">Upload NFT marker</button>
    </div>
    <p class="wk-tool__note">
      Select all three files at once. Legend: <span class="fsd-swatch fsd-fset"></span> feature points
      (FeatureSet) · <span class="fsd-swatch fsd-fset3"></span> FeatureSet3 points.
    </p>
    <p class="wk-tool__note fsd-status" id="fsdStatus" role="status"></p>
    <div id="cv" class="fsd-stage"></div>
  </div>

  <script is:inline src="./dist/ARFset.js"></script>
  <script is:inline src="./index.js"></script>
  <script is:inline>
    document.getElementById('uploadBt').addEventListener('click', () =>
      document.getElementById('markerLoader').click(),
    );
  </script>
</ToolLayout>

<style>
  .fsd-stage {
    margin-top: 16px;
    min-height: 120px;
    overflow: auto;
    background: var(--wk-camera);
    border-radius: var(--wk-radius-sm);
  }
  .fsd-status {
    color: var(--wk-accent);
    font-weight: 600;
  }
  .fsd-status:empty {
    display: none;
  }
  .fsd-swatch {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    vertical-align: middle;
  }
  .fsd-fset {
    background: #90ee90;
  }
  .fsd-fset3 {
    background: #ff4d4d;
    width: 6px;
    height: 6px;
  }
</style>
